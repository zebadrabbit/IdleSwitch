# The host caches .css and images for 7 days by default, so a deploy that changes
# style.css leaves browsers pairing the new page with the old stylesheet.
# no-cache = revalidate every time (cheap 304s); the page and JS already behave this way.
<IfModule mod_expires.c>
  ExpiresActive Off
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(css|svg)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
